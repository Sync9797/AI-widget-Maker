<?xml version="1.0" encoding="utf-8"?>
<!-- Glass widget background: a smoky translucent tint, a soft highlight at the top and a bright edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient android:angle="270" android:startColor="#7A1C2333" android:endColor="#590B0F1A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient android:angle="270" android:startColor="#2EFFFFFF" android:centerColor="#08FFFFFF" android:endColor="#00FFFFFF" />
            <stroke android:width="1dp" android:color="#4DFFFFFF" />
        </shape>
    </item>
</layer-list>
